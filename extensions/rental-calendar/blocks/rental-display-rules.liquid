{% comment %}
  Miko Rental Display Rules - App Embed Block

  Sitewide block that hides the regular price and/or Add to cart button on
  any product the merchant has enabled as a rental. Detects rental products
  via the `miko.is_rental` metafield, which the app sets automatically when
  a rental is activated.

  Add this once via the Online Store > Themes > Customize > App embeds
  panel and it applies across every product page and collection page.
{% endcomment %}

{%- liquid
  assign hide_pdp_price = block.settings.hide_price_pdp
  assign hide_pdp_button = block.settings.hide_buy_button_pdp
  assign hide_collection_price = block.settings.hide_price_collection
  assign app_url = block.settings.app_url | default: 'https://miko-product-rentals-production.up.railway.app'
-%}

{%- comment -%}
  Once-per-session ping so the merchant dashboard can auto-detect that the
  embed is live and tick the corresponding onboarding step. Uses
  sessionStorage so we ping at most one time per browser session, not on
  every page navigation.
{%- endcomment -%}
<script>
  (function () {
    try {
      if (sessionStorage.getItem('mikoDisplayRulesPinged')) return;
      sessionStorage.setItem('mikoDisplayRulesPinged', '1');
      var img = new Image();
      img.src = '{{ app_url }}/api/embed-ping?shop={{ shop.permanent_domain | url_encode }}';
    } catch (e) { /* sessionStorage blocked - silently skip */ }
  })();
</script>

{%- comment -%}
  Sitewide enforcement: hide the quantity selector on any cart line that
  carries our `_miko_data` line item property. Runs on EVERY page (not just
  the cart page) so it covers cart drawers / slide-outs that themes open
  from product pages, the header, collection pages, etc. The
  MutationObserver picks up the drawer's qty controls the moment it mounts.

  Even if a customer bypasses this and changes the qty via the cart API
  directly, the Cart Transform Function rescales the per-unit price so the
  total stays locked to what they booked.
{%- endcomment -%}
<script>
  (function () {
    var LINE_SELECTORS = [
      '[data-key]', '[data-cart-item]', '[data-line-item]',
      '.cart-item', '.cart__row', '.cart-items__row', '.cart-drawer__item',
      '.drawer-cart-item', '.line-item', '.cart-line',
      'tr[class*="cart"]', 'li[class*="cart"]', 'div[class*="cart-item"]',
      '[data-cart-item-key]', '[data-line-key]', '[class*="cart-items__row"]', '[class*="line-item"]',
      '[class*="cart__item"]', '[class*="CartItem"]', '[class*="cart-drawer-item"]', 'cart-item', 'line-item',
    ].join(',');

    // Quantity controls, recognised by what they ARE rather than one theme's class names, so the lock
    // holds on Dawn/Rise (quantity-input), Horizon/Atelier (quantity-selector-component, updates[]),
    // and vintage or custom themes alike (verified 2026-09-24).
    var QTY_SELECTORS = [
      'input[type="number"]', 'input[name^="updates"]', 'input[name*="quantity" i]', 'select[name*="quantity" i]',
      'button[name*="minus" i]', 'button[name*="plus" i]', 'button[aria-label*="increase" i]', 'button[aria-label*="decrease" i]',
      'button[aria-label*="quantity" i]', '[data-quantity-selector]', '[data-qty]',
      'quantity-input', 'quantity-popover', 'quantity-selector-component', 'plus-button', 'minus-button',
      '.quantity', '.qty', '[class*="quantity-selector"]', '[class*="quantity__"]', '[class*="cart__quantity"]',
      '[class*="cart-item__qty"]', '[class*="cart-item__quantity"]', '[class*="drawer-cart-item__qty"]', '[class*="qty-selector"]',
      '[class*="js-qty"]', 'button[aria-label*="reduce" i]', 'button[aria-label*="add one" i]', 'button[aria-label*="subtract" i]',
    ].join(',');

    // Remove controls must ALWAYS stay usable. On Dawn-family themes Remove lives inside the same
    // wrapper as the quantity selector; hiding the wrapper hid Remove (support ticket 2026-09-24).
    var REMOVE_SELECTORS = [
      'cart-remove-button', 'a[href*="/cart/change"]', 'a[href*="quantity=0"]', '[name="remove"]',
      '[data-remove]', '[data-cart-remove]', '[class*="remove"]', '[class*="delete"]',
      'button[aria-label*="remove" i]', 'a[aria-label*="remove" i]', 'button[aria-label*="delete" i]', '[id*="Remove"]',
    ].join(',');

    // Rental lines are known from Shopify's own cart data, so detection does not depend on the
    // theme printing line properties (many drawers do not).
    // The cart labels in the store's language (locales/*.json), e.g. レンタル開始日 on a Japanese store.
    var LABELS = [{{ 'calendar.prop_start' | t | json }}, {{ 'calendar.prop_duration' | t | json }}, {{ 'calendar.prop_return' | t | json }}];
    var rentalKeys = [], rentalIdx = [];
    function refreshCart() {
      return fetch((window.Shopify && Shopify.routes && Shopify.routes.root || '/') + 'cart.js', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (c) {
          rentalKeys = []; rentalIdx = [];
          (c.items || []).forEach(function (it, i) {
            if (it.properties && it.properties._miko_data) { rentalKeys.push(it.key); rentalIdx.push(i + 1); }
          });
        }).catch(function () {});
    }

    function isRentalLine(el) {
      var text = el.textContent || '';
      if (text.indexOf('Rental start') !== -1 || text.indexOf('Rental duration') !== -1 || text.indexOf('Return by') !== -1) return true;
      for (var l = 0; l < LABELS.length; l++) { if (LABELS[l] && text.indexOf(LABELS[l]) !== -1) return true; }
      var html = el.innerHTML || '';
      for (var k = 0; k < rentalKeys.length; k++) {
        if (el.getAttribute('data-key') === rentalKeys[k] || html.indexOf(rentalKeys[k]) !== -1) return true;
      }
      for (var n = 0; n < rentalIdx.length; n++) {
        var i = rentalIdx[n];
        if (el.getAttribute('data-index') === String(i) || el.getAttribute('data-line') === String(i) ||
            html.indexOf('line=' + i + '&') !== -1 || html.indexOf('/onLineItemRemove/' + i + '"') !== -1 ||
            html.indexOf('data-index="' + i + '"') !== -1) return true;
      }
      return false;
    }

    function lockLine(line) {
      var controls = line.querySelectorAll(QTY_SELECTORS);
      for (var j = 0; j < controls.length; j++) {
        var c = controls[j];
        if (c.matches(REMOVE_SELECTORS) || c.closest('a,button') && c.closest('a,button').matches(REMOVE_SELECTORS)) continue;
        if (c.querySelector(REMOVE_SELECTORS)) continue;   // a wrapper that also holds Remove: its inner parts are handled on their own
        c.style.setProperty('display', 'none', 'important');
      }
      var removes = line.querySelectorAll(REMOVE_SELECTORS);
      for (var r = 0; r < removes.length; r++) {
        var el = removes[r];
        while (el && el !== line) { if (el.style && el.style.display === 'none') el.style.removeProperty('display'); el = el.parentElement; }
      }
    }

    function hideRentalQty() {
      var lines = document.querySelectorAll(LINE_SELECTORS);
      for (var i = 0; i < lines.length; i++) {
        if (!isRentalLine(lines[i])) continue;
        // Lock only the innermost matching line element, never a whole cart container.
        if (lines[i].querySelector(LINE_SELECTORS) && [].some.call(lines[i].querySelectorAll(LINE_SELECTORS), isRentalLine)) continue;
        lockLine(lines[i]);
      }
    }

    function run() { hideRentalQty(); refreshCart().then(hideRentalQty); }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }

    // Themes mount cart drawers asynchronously. MutationObserver catches the
    // drawer opening, ajax cart refreshes, and Section Rendering API updates.
    var observer = new MutationObserver(function () {
      // Debounce so we don't run on every keystroke in unrelated inputs.
      if (window.__mikoQtyTimer) clearTimeout(window.__mikoQtyTimer);
      window.__mikoQtyTimer = setTimeout(hideRentalQty, 50);
    });
    observer.observe(document.documentElement, { childList: true, subtree: true });

    // Some themes fire cart events when the drawer is opened or refreshed.
    ['cart:refresh', 'cart:open', 'cart:updated', 'cart:change'].forEach(function (evt) {
      document.addEventListener(evt, run);
    });
  })();
</script>

{%- if request.page_type == 'product' and product.metafields.miko.is_rental -%}
  <style data-miko-display-rules="pdp">
    {%- if hide_pdp_price -%}
      .product__price, .price, .product-price, .product__price-wrapper,
      .price-item, [data-product-price], .product-block--price,
      .product__pricing, .product-single__price,
      .price--regular, .price__regular { display: none !important; }
    {%- endif -%}
    {%- if hide_pdp_button -%}
      .product-form__buttons, .product__buy-buttons, .shopify-payment-button,
      form[action*="/cart/add"] .btn,
      form[action*="/cart/add"] button[type="submit"]:not(.miko-btn),
      form[action*="/cart/add"] .product-form__submit,
      [data-type="add-to-cart-form"] button[type="submit"] { display: none !important; }
      /* Quantity selector - belongs to the regular buy flow, hide alongside the button. */
      .product-form__quantity, .product__quantity, .product-single__quantity,
      quantity-input, quantity-popover, quantity-popover-container,
      .quantity, .quantity-selector, .product-quantity, .product__quantity-wrapper,
      [data-quantity-selector] { display: none !important; }
    {%- endif -%}
  </style>
{%- endif -%}

{%- comment -%}
  Sitewide rental badge + price-hide. Runs on EVERY page (not just collection
  pages) so it covers home-page featured-product grids, search results,
  related-product strips, etc. - anywhere a rental product card might appear.

  We identify rental cards by product HANDLE in the link href, because the
  data-product-id attribute that older code relied on is not present on
  most modern themes (Dawn, Horizon, Sense, Refresh, Studio, ...). Handles
  are stable, themable-agnostic, and always in the /products/<handle> URL.
{%- endcomment -%}
{%- if hide_collection_price -%}
  {%- assign rental_handles = "" -%}
  {%- for prod in collection.products limit: 250 -%}
    {%- if prod.metafields.miko.is_rental -%}
      {%- assign rental_handles = rental_handles | append: prod.handle | append: "," -%}
    {%- endif -%}
  {%- endfor -%}
  {%- comment -%}
    On non-collection pages (home, search, etc.) `collection` is empty. Fall
    back to scanning featured collections / all products via a recommendations
    pattern - but cheapest is a global allowlist seeded by all_products. To
    keep this lightweight we also include `all_products` when on home page.
  {%- endcomment -%}
  {%- if request.page_type == 'index' or request.page_type == 'search' or request.page_type == 'product' -%}
    {%- for prod in collections.all.products limit: 250 -%}
      {%- if prod.metafields.miko.is_rental -%}
        {%- unless rental_handles contains prod.handle -%}
          {%- assign rental_handles = rental_handles | append: prod.handle | append: "," -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if rental_handles != "" and request.page_type != 'product' -%}
    <style data-miko-display-rules="collection-badge">
      [data-miko-rental-card] {
        position: relative;
      }
      [data-miko-rental-card] .price,
      [data-miko-rental-card] [class*="price" i]:not(.miko-rental-badge):not([class*="strikethrough" i]),
      [data-miko-rental-card] [data-product-price],
      [data-miko-rental-card] .product-price,
      [data-miko-rental-card] .product__price,
      [data-miko-rental-card] .card__price,
      [data-miko-rental-card] .card-information__price,
      [data-miko-rental-card] .price-item,
      [data-miko-rental-card] .price__regular,
      [data-miko-rental-card] .price__current,
      [data-miko-rental-card] money-element {
        display: none !important;
      }
      .miko-rental-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 10px;
        background: #0e1b3a;
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        border-radius: 4px;
        pointer-events: none;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        box-shadow: 0 2px 6px rgba(14, 27, 58, 0.25);
      }
      .miko-rental-badge::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #6366f1;
      }
    </style>
    <script data-miko-display-rules="collection">
      (function () {
        var handles = "{{ rental_handles }}".split(",").filter(Boolean);
        if (!handles.length) return;
        var handleSet = new Set(handles);

        // Walk up from a product link to the surrounding CARD ROOT - not an
        // inner BEM sub-element like `card__heading` or `card__information`.
        // Strategy: prefer the first LI / ARTICLE ancestor (every standard
        // theme wraps each grid product in one of those). Falls back to a
        // wrapper-class match (`card-wrapper`, `product-card`, `grid__item`)
        // for themes that use plain DIVs.
        var CARD_WRAPPER_RE = /(?:^|\s)(card-wrapper|product-card-wrapper|product-card|product-item|grid__item|grid-item|collection-item|featured-collection__item|productitem)(?:\s|$|--)/i;
        function findCard(anchor) {
          var node = anchor.parentElement;
          for (var i = 0; i < 10 && node && node.tagName !== 'BODY'; i++) {
            var tag = node.tagName;
            if (tag === 'LI' || tag === 'ARTICLE') return node;
            var cls = (typeof node.className === 'string') ? node.className : '';
            if (CARD_WRAPPER_RE.test(cls)) return node;
            node = node.parentElement;
          }
          return null;
        }

        function extractHandle(href) {
          // /products/<handle>(?...|#...|/...)
          var m = href.match(/\/products\/([^/?#]+)/);
          return m ? m[1] : null;
        }

        function tagRentalCards() {
          var anchors = document.querySelectorAll('a[href*="/products/"]');
          for (var i = 0; i < anchors.length; i++) {
            var a = anchors[i];
            var handle = extractHandle(a.getAttribute('href') || '');
            if (!handle || !handleSet.has(handle)) continue;
            var card = findCard(a);
            if (!card || card.hasAttribute('data-miko-rental-card')) continue;
            card.setAttribute('data-miko-rental-card', '1');
            // Skip badge injection on PDPs - we already hide the price there
            // via a different rule and a "Rental" badge would be redundant.
            if (document.body && document.body.classList.contains('template-product')) continue;
            var badge = document.createElement('span');
            badge.className = 'miko-rental-badge';
            badge.textContent = 'Rental';
            card.insertBefore(badge, card.firstChild);
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', tagRentalCards);
        } else {
          tagRentalCards();
        }
        // Re-run after lazy-loaded grids / infinite scroll / drawer mounts.
        new MutationObserver(function () {
          if (window.__mikoBadgeTimer) clearTimeout(window.__mikoBadgeTimer);
          window.__mikoBadgeTimer = setTimeout(tagRentalCards, 100);
        }).observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Miko Rental Display Rules",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "Controls how rental products appear across your storefront. Only products you have enabled as rentals in the Miko app are affected."
    },
    {
      "type": "checkbox",
      "id": "hide_price_pdp",
      "label": "Hide regular price on rental product pages",
      "info": "The rental price (from the booking widget) is shown instead.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_buy_button_pdp",
      "label": "Hide Add to cart button on rental product pages",
      "info": "Customers can only check out via the Book now button from the rental widget.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_price_collection",
      "label": "Hide regular price on rental cards in collection pages",
      "info": "Hides the price on rental products when shown in collection or search listings. Works best with standard themes - some custom themes may need manual CSS.",
      "default": true
    },
    {
      "type": "url",
      "id": "app_url",
      "label": "App URL (advanced)",
      "info": "Leave blank. Only needed if you run the app on a custom domain."
    }
  ]
}
{% endschema %}
